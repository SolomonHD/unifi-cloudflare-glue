            .withArg("wasabi_access_key", typeDef.withObject("Secret"), description: "A reference to a secret value, which can be handled more safely\nthan the value itself.")
            .withArg("wasabi_secret_key", typeDef.withObject("Secret"), description: "A reference to a secret value, which can be handled more safely\nthan the value itself.")
            .withArg("prior_writer_terminated", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), defaultValue: ("false" :: Dagger.JSON!))
            .withArg("exclusive_writer", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), defaultValue: ("false" :: Dagger.JSON!))
        )
        .withFunction(
          function("test_cloudflare_dns_canary", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Qualify the sandbox, then create/update/verify/destroy two DNS records.\n\nRuntime Secrets never become Python application strings. Unknown effects\nretain the durable claim for separately authorized reconciliation.")
            .withCachePolicy(FunctionCachePolicy.Never)
            .withArg("cloudflare_api_token", typeDef.withObject("Secret"), description: "A reference to a secret value, which can be handled more safely\nthan the value itself.")
            .withArg("wasabi_access_key", typeDef.withObject("Secret"), description: "A reference to a secret value, which can be handled more safely\nthan the value itself.")
            .withArg("wasabi_secret_key", typeDef.withObject("Secret"), description: "A reference to a secret value, which can be handled more safely\nthan the value itself.")
            .withArg("bucket", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("revision", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("run_id", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("attempt", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("repository", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("ref", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("event_name", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withArg("acceptance_sha", typeDef.withKind(TypeDefKind.STRING_KIND), defaultValue: ("\"\"" :: Dagger.JSON!))
            .withArg("acceptance_branch", typeDef.withKind(TypeDefKind.STRING_KIND), defaultValue: ("\"\"" :: Dagger.JSON!))
            .withArg("policy_reviewed", typeDef.withKind(TypeDefKind.STRING_KIND), defaultValue: ("\"false\"" :: Dagger.JSON!))
            .withArg("operation", typeDef.withKind(TypeDefKind.STRING_KIND), defaultValue: ("\"normal\"" :: Dagger.JSON!))
        )
        .withFunction(
          function("test_integration", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Run integration test creating ephemeral DNS resources with real APIs.\n\nCreates temporary Cloudflare tunnel and DNS records, UniFi DNS records,\nvalidates the setup, and attempts cleanup with a separate outcome ledger.\nThis is an effectful disposable lifecycle, not an offline verification\nor a production deployment shortcut. Explicit authorization is required.\nCancellation/disconnect can leave unknown effects; reconcile before retry.\n\nAuthentication options (pick one):\n1. API Key: Provide unifi_api_key\n2. Username/Password: Provide both unifi_username AND unifi_password\n\nArgs:\n    source: Project source directory containing KCL and Terraform configs\n    cloudflare_zone: DNS zone for test records (e.g., test.example.com)\n    cloudflare_token: Cloudflare API token\n    cloudflare_account_id: Cloudflare account ID\n    unifi_url: UniFi controller URL (e.g., https://unifi.local:8443)\n    api_url: UniFi API URL (often same as unifi_url)\n    unifi_api_key: UniFi API key (mutually exclusive with username/password)\n    unifi_username: UniFi username (use with password)\n    unifi_password: UniFi password (use with username)\n    unifi_insecure: Skip TLS verification for self-signed certificates\n    cleanup: Whether to cleanup resources after test (default: true)\n    validate_connectivity: Whether to test actual HTTP connectivity\n    test_timeout: Timeout for test operations (e.g., 5m)\n    cache_buster: Optional bounded non-secret label; live freshness is automatic\n    wait_before_cleanup: Seconds to wait between validation and cleanup.\n        Allows manual verification of created resources before they are destroyed.\n    test_mac_address: MAC address for the test device. This MAC must exist in your\n        UniFi controller. Use a real device MAC from your network (default: \"aa:bb:cc:dd:ee:ff\")\n    terraform_version: Reviewed digest-pinned Terraform (default: \"1.13.5\")\n    kcl_version: Checksum-verified official KCL (default: \"0.12.4\")\n\nReturns:\n    Detailed test report with created resources, validation results, and cleanup status.\n\nExample usage:\n    # Only after sandbox mutation authorization; use the pinned receipt engine URI.\n    dagger --engine \"$DAGGER_ENGINE\" api call -m . test-integration \\\n        --source=. \\\n        --cloudflare-zone=test.example.com \\\n        --cloudflare-token=env://CF_TOKEN \\\n        --cloudflare-account-id=xxx \\\n        --unifi-api-key=env://UNIFI_API_KEY \\\n        --unifi-url=https://unifi.local:8443 \\\n        --api-url=https://unifi.local:8443 \\\n        --test-mac-address=de:ad:be:ef:12:34")
            .withCachePolicy(FunctionCachePolicy.Never)
            .withArg("source", typeDef.withObject("Directory"), description: "Project source directory containing KCL and Terraform configs")
            .withArg("cloudflare_zone", typeDef.withKind(TypeDefKind.STRING_KIND), description: "DNS zone for test records (e.g., test.example.com)")
            .withArg("cloudflare_token", typeDef.withObject("Secret"), description: "Cloudflare API token")
            .withArg("cloudflare_account_id", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Cloudflare account ID")
            .withArg("unifi_url", typeDef.withKind(TypeDefKind.STRING_KIND), description: "UniFi controller URL (e.g., https://unifi.local:8443)")
            .withArg("api_url", typeDef.withKind(TypeDefKind.STRING_KIND), description: "UniFi API URL (often same as unifi_url)")
            .withArg("unifi_api_key", typeDef.withOptional(true).withObject("Secret").withOptional(true), description: "UniFi API key (mutually exclusive with username/password)", defaultValue: ("null" :: Dagger.JSON!))
            .withArg("unifi_username", typeDef.withOptional(true).withObject("Secret").withOptional(true), description: "UniFi username (use with password)", defaultValue: ("null" :: Dagger.JSON!))
            .withArg("unifi_password", typeDef.withOptional(true).withObject("Secret").withOptional(true), description: "UniFi password (use with username)", defaultValue: ("null" :: Dagger.JSON!))
            .withArg("unifi_insecure", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Skip TLS verification for UniFi controller (useful for self-signed certificates)", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("cleanup", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Whether to cleanup resources after test (default: true)", defaultValue: ("true" :: Dagger.JSON!))
            .withArg("validate_connectivity", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Whether to test actual HTTP connectivity", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("test_timeout", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Timeout for test operations (e.g., 5m)", defaultValue: ("\"5m\"" :: Dagger.JSON!))
            .withArg("cache_buster", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Optional non-secret run label, at most 80 letters/digits/._-; not freshness", defaultValue: ("\"\"" :: Dagger.JSON!))
            .withArg("wait_before_cleanup", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Seconds to wait between validation and cleanup for manual verification", defaultValue: ("0" :: Dagger.JSON!))
            .withArg("test_mac_address", typeDef.withKind(TypeDefKind.STRING_KIND), description: "MAC address for test device (must exist in UniFi controller, e.g., 'aa:bb:cc:dd:ee:ff')", defaultValue: ("\"aa:bb:cc:dd:ee:ff\"" :: Dagger.JSON!))
            .withArg("terraform_version", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Reviewed immutable Terraform release", defaultValue: ("\"1.13.5\"" :: Dagger.JSON!))
            .withArg("kcl_version", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Reviewed KCL release", defaultValue: ("\"0.12.4\"" :: Dagger.JSON!))
        )
        .withFunction(
          function("test_unifi_dns_baseline", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Run the isolated UniFi v1.1 DNS create/read/update/destroy baseline.\n\nThe API key is mounted as a Dagger secret and Terraform state remains\ninside the lifecycle containers. Cleanup and provider-level absence\nchecks are mandatory. Use only after authorizing live UniFi DNS changes.\n\nExample:\n    dagger --engine \"$DAGGER_ENGINE\" api call -m . test-unifi-dns-baseline \\\n        --source=. \\\n        --run-id=20260828-a1b2c3 \\\n        --unifi-url=https://192.168.60.1 \\\n        --unifi-api-key=env://UNIFI_API_KEY")
            .withCachePolicy(FunctionCachePolicy.Never)
            .withArg("source", typeDef.withObject("Directory"), description: "Project source containing the baseline fixture")
            .withArg("run_id", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Unique 6-32 character lowercase run identifier for sandbox isolation")
            .withArg("unifi_url", typeDef.withKind(TypeDefKind.STRING_KIND), description: "UniFi controller URL")
            .withArg("unifi_api_key", typeDef.withObject("Secret"), description: "UniFi API key")
            .withArg("api_url", typeDef.withKind(TypeDefKind.STRING_KIND), description: "UniFi API URL; defaults to unifi_url", defaultValue: ("\"\"" :: Dagger.JSON!))
            .withArg("site", typeDef.withKind(TypeDefKind.STRING_KIND), description: "UniFi site for disposable DNS records", defaultValue: ("\"default\"" :: Dagger.JSON!))
            .withArg("unifi_insecure", typeDef.withKind(TypeDefKind.BOOLEAN_KIND), description: "Skip UniFi TLS verification", defaultValue: ("false" :: Dagger.JSON!))
            .withArg("a_record_count", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Number of disposable A records", defaultValue: ("64" :: Dagger.JSON!))
            .withArg("cname_record_count", typeDef.withKind(TypeDefKind.INTEGER_KIND), description: "Number of disposable CNAME records", defaultValue: ("64" :: Dagger.JSON!))
            .withArg("test_timeout", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Shared lifecycle timeout, such as 10m", defaultValue: ("\"10m\"" :: Dagger.JSON!))
            .withArg("terraform_version", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Reviewed Terraform image version", defaultValue: ("\"1.13.5\"" :: Dagger.JSON!))
            .withArg("cache_buster", typeDef.withKind(TypeDefKind.STRING_KIND), description: "Optional bounded non-secret run label; not freshness", defaultValue: ("\"\"" :: Dagger.JSON!))
        )
        .withFunction(
          function("verify_offline", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Run credential-free verification without exporting checkout files.")
            .withArg("source", typeDef.withObject("Directory"), description: "A directory.")
        )
        .withFunction(
          function("version", typeDef.withKind(TypeDefKind.STRING_KIND))
            .withDescription("Return the current version of unifi-cloudflare-glue.\n\nReads the VERSION file from the source directory and returns the\nversion string. All components (KCL, Terraform, Dagger) share\nthe same version number.\n\nArgs:\n    source: Directory containing the VERSION file (use --source=.)\n\nReturns:\n    Version string (e.g., \"0.1.0\")\n\nExample:\n    dagger --engine \"$DAGGER_ENGINE\" api call -m . version --source=.")
            .withArg("source", typeDef.withObject("Directory"), description: "Source directory containing VERSION file")
        )
        .withConstructor(
          function("", typeDef.withObject("UnifiCloudflareGlue"))
            .withDescription("UniFi Cloudflare Glue - Hybrid DNS infrastructure management.")
        ),
    ]
  }
}
